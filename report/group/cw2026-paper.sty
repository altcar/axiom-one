\urlstyle{same}

\definecolor{papergrey}{gray}{0.40}
\definecolor{paperrule}{gray}{0.65}
\setlength{\columnsep}{7mm}
\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt}
\setlength{\multicolsep}{0pt}
\setlength{\emergencystretch}{1.5em}
\titleformat{\section}{\large\bfseries}{\thesection.}{0.5em}{}
\titlespacing*{\section}{0pt}{4pt}{1pt}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.5em}{}
\titlespacing*{\subsection}{0pt}{4pt}{1pt}
\captionsetup{font=small,labelfont=bf,labelsep=period,
  justification=raggedright,singlelinecheck=false,hypcap=false,skip=5pt}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\color{papergrey}SEMTM0043/42\enspace\textbar\enspace Assessment 2, Group Basis: Scientific Report}
\fancyfoot[R]{\footnotesize\thepage}

\newcommand{\PaperTitleBlock}{%
  \begingroup\centering
  {\fontsize{17}{27}\selectfont\bfseries\PaperTitle\par}
  \vspace{1pt}
  {\fontsize{10}{27}\StudentNumbers\par}
  \vspace{11pt}
  \endgroup
  \hypersetup{pdftitle={\PaperTitle},pdfauthor={},pdfsubject={Assessment 2, Group Basis: Scientific Report}}
}

% Usage: \PaperFigure[height]{image path or empty}{placeholder title}
%          {placeholder guidance}{caption}{label}
% Non-floating figures stay beside the text that explains them.
\newcommand{\PaperFigure}[6][63mm]{%
  \par\addvspace{5pt}\noindent
  \begin{minipage}{\linewidth}
    \if\relax\detokenize{#2}\relax
      {\setlength{\fboxsep}{0pt}\color{paperrule}%
      \fbox{\parbox[c][#1][c]{\dimexpr\linewidth-2\fboxrule\relax}{%
        \centering\color{papergrey}\small
        \begin{minipage}{0.88\linewidth}\centering
          \textbf{#3}\par\vspace{7pt}#4
        \end{minipage}\par}}}
    \else
      \centering\includegraphics[width=\linewidth,height=#1,keepaspectratio]{#2}
    \fi
    \captionof{figure}{#5}\label{#6}
  \end{minipage}\par\addvspace{4pt}
}

% Start the next scaffold column. Move/remove these breaks as the paper develops.
\newcommand{\NextPaperColumn}{\columnbreak}
